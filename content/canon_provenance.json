{"canon_version":"5.0.0","content_version":"0.51.1","records":[{"canon_status":"explicit_canon","canonical_id":"sol","display_name":"Sol beneath the control lattice","entity_id":"sol_confrontation","entity_key":"creature:sol_confrontation","entity_type":"creature","gameplay_interpretation":"This is an authored training confrontation using Sol's canonical rivalry and control themes; the control lattice and encounter are artistic gameplay interpretation.","source_authority":"combined_with_gameplay_interpretation","source_refs":["LEGACY-043","LEGACY-059","PARADISE-030","PARADISE-034"],"timeline":"game_continuity_unspecified"},{"canon_status":"unspecified","canonical_id":null,"display_name":"Armageddon","entity_id":"armageddon","entity_key":"faction:armageddon","entity_type":"faction","gameplay_interpretation":"Preserves the supplied Beta Earth Online seven-realm design. The faction structure is not silently promoted into the three-book story canon.","source_authority":"beta_earth_online_design","source_refs":["GAME_DESIGN:Faction Information and Classes.doc"],"timeline":"not_applicable"},{"canon_status":"unspecified","canonical_id":null,"display_name":"Bounty Hunters","entity_id":"bounty_hunters","entity_key":"faction:bounty_hunters","entity_type":"faction","gameplay_interpretation":"Preserves the supplied player-faction and contract-role design without asserting a unified story-canon institution where the books do not establish one.","source_authority":"beta_earth_online_design","source_refs":["GAME_DESIGN:Faction Information and Classes.doc","GAME_DESIGN:Guild Play and Tactics.doc"],"timeline":"not_applicable"},{"canon_status":"explicit_canon","canonical_id":null,"display_name":"Final Bloodline","entity_id":"final_bloodline","entity_key":"faction:final_bloodline","entity_type":"faction","gameplay_interpretation":"The faction and its faith are canonical; player-class labels and progression are taken from the Beta Earth Online design.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-033","LEGACY-010","PARADISE-025","GAME_DESIGN:Faction Information and Classes.doc"],"timeline":"not_applicable"},{"canon_status":"strong_inference","canonical_id":null,"display_name":"Guardian Angel","entity_id":"guardian_angel","entity_key":"faction:guardian_angel","entity_type":"faction","gameplay_interpretation":"Project Guardian and its survivors are canonical; Guardian Angel as a player faction and its rank/class ladder come from the Beta Earth Online design source.","source_authority":"combined_with_gameplay_interpretation","source_refs":["LEGACY-009","LEGACY-026","GAME_DESIGN:Faction Information and Classes.doc"],"timeline":"not_applicable"},{"canon_status":"explicit_canon","canonical_id":null,"display_name":"Redemption","entity_id":"redemption","entity_key":"faction:redemption","entity_type":"faction","gameplay_interpretation":"Redemption is canonical; the System/Engineer progression and MMO role package come from the supplied game-design document.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-046","LEGACY-003","PARADISE-005","GAME_DESIGN:Faction Information and Classes.doc"],"timeline":"not_applicable"},{"canon_status":"explicit_canon","canonical_id":null,"display_name":"Security / United Federation","entity_id":"security_uf","entity_key":"faction:security_uf","entity_type":"faction","gameplay_interpretation":"The United Federation is canonical; Security recruitment, teaching, rank, commander, and camp gameplay preserve the Beta Earth Online design source.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-003","LEGACY-004","PARADISE-026","GAME_DESIGN:Faction Information and Classes.doc"],"timeline":"not_applicable"},{"canon_status":"explicit_canon","canonical_id":null,"display_name":"Syndicate","entity_id":"syndicate","entity_key":"faction:syndicate","entity_type":"faction","gameplay_interpretation":"The Syndicate is canonical; class ranks and player progression preserve the separate Beta Earth Online design source.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-024","LEGACY-039","PARADISE-010","GAME_DESIGN:Faction Information and Classes.doc"],"timeline":"not_applicable"},{"canon_status":"explicit_canon","canonical_id":"sol","display_name":"Sol","entity_id":"sol","entity_key":"mercenary:sol","entity_type":"mercenary","gameplay_interpretation":"The generic mercenary contract exposes Sol through the reusable party system; it is a gameplay interface and does not redefine his canonical allegiance or status.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-029","LEGACY-059","PARADISE-034"],"timeline":"game_continuity_unspecified"},{"canon_status":"explicit_canon","canonical_id":"clave","display_name":"Clave","entity_id":"clave","entity_key":"npc:clave","entity_type":"npc","gameplay_interpretation":"Clave's identity, adaptive combat lineage, shifting, possession history, and restored agency are canonical. His course and encounter placement are game structure rather than a claim that the saga scenes occurred in this order.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-005","LEGACY-038","PARADISE-017","PARADISE-034","PARADISE-035"],"timeline":"game_continuity_unspecified"},{"canon_status":"explicit_canon","canonical_id":"sol","display_name":"Sol","entity_id":"sol","entity_key":"npc:sol","entity_type":"npc","gameplay_interpretation":"Sol's identity, Akari-line training, concussion-gauntlet history, rivalry, remorse, and sacrifice derive from the supplied saga. His living role as the player's early companion is a game-continuity placement and does not overwrite his Paradise ending.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-029","LEGACY-059","PARADISE-034","PARADISE-035"],"timeline":"game_continuity_unspecified"},{"canon_status":"artistic_interpretation","canonical_id":null,"display_name":"Earth — Sprawl 15, Intake Concourse","entity_id":"intake_concourse","entity_key":"room:intake_concourse","entity_type":"room","gameplay_interpretation":"Sprawl 15 and its abandonment/protection economy are canonical; the intake concourse and Recall/Collector staging are original game-space interpretation.","source_authority":"combined_with_gameplay_interpretation","source_refs":["BETWEEN_WORLDS-006","BETWEEN_WORLDS-008","GAME_DESIGN:Land of Beta Earth.doc"],"timeline":"game_continuity_unspecified"}],"schema_version":1}
